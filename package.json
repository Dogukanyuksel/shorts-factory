{
  "name": "shorts-factory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "render": "tsx src/render.ts",
    "explainer": "tsx src/render-explainer.ts",
    "longform": "tsx src/render-longform.ts",
    "publish:longform:explainer": "tsx src/publish-longform.ts --channel explainer",
    "publish:longform:physics": "tsx src/publish-longform.ts --channel physics",
    "batch": "tsx src/render-batch.ts",
    "youtube:auth": "tsx src/youtube-auth.ts",
    "publish:physics": "tsx src/auto-publish.ts --channel physics",
    "publish:explainer": "tsx src/auto-publish.ts --channel explainer",
    "analytics": "tsx src/analytics.ts",
    "telegram:monitor": "tsx src/telegram-monitor.ts",
    "ideas": "tsx src/idea-factory.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "playwright-core": "^1.52.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
}
